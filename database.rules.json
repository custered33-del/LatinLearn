{
  "rules": {
    "saves": {
      "$code": {
        ".read": "$code.matches(/^[0-9]{10}$/)",
        ".write": "$code.matches(/^[0-9]{10}$/)",
        ".validate": "newData.child('app').val() === 'LatinLearn' && newData.child('progress').exists()",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "lang": {
          ".validate": "newData.isString() && newData.val().length <= 5"
        },
        "friendId": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{8}$/)"
        }
      }
    },
    "families": {
      "$family": {
        ".read": "$family.matches(/^[0-9]{7}$/)",
        "members": {
          "$member": {
            ".write": "$family.matches(/^[0-9]{7}$/) && $member.matches(/^[a-z0-9]{12}$/)",
            ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 20 && newData.child('xp').isNumber())"
          }
        },
        "days": {
          "$day": {
            "$member": {
              ".write": "$family.matches(/^[0-9]{7}$/) && $day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && $member.matches(/^[a-z0-9]{12}$/)",
              ".validate": "newData.isNumber()"
            }
          }
        },
        "comp": {
          ".write": "$family.matches(/^[0-9]{7}$/)",
          ".validate": "!newData.exists() || (newData.child('by').isString() && newData.child('created').isNumber() && newData.child('mins').isNumber())",
          "scores": {
            "$member": {
              ".validate": "$member.matches(/^[a-z0-9]{12}$/) && newData.child('best').isNumber() && newData.child('name').isString()"
            }
          },
          "votes": {
            "$member": {
              ".validate": "$member.matches(/^[a-z0-9]{12}$/) && newData.isString() && newData.val().length <= 20"
            }
          }
        }
      }
    },
    "profiles": {
      ".read": "query.orderByChild === 'xp' && query.limitToLast <= 10",
      ".indexOn": [
        "xp"
      ],
      "$fid": {
        ".read": "$fid.matches(/^[0-9]{8}$/)",
        ".write": "$fid.matches(/^[0-9]{8}$/)",
        ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 20 && newData.child('xp').isNumber() && newData.child('xp').val() >= 0 && newData.child('xp').val() < 10000000 && newData.child('streak').isNumber()",
        "langs": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "friends": {
          "$other": {
            ".validate": "$other.matches(/^[0-9]{8}$/) && newData.val() === true"
          }
        }
      }
    },
    "push": {
      "$id": {
        ".write": "$id.matches(/^[a-z0-9]{20}$/)",
        ".validate": "newData.child('sub').child('endpoint').isString() && newData.child('tz').isString()",
        "sub": {
          "endpoint": {
            ".validate": "newData.isString() && newData.val().length < 1000 && newData.val().matches(/^https:\\/\\/(fcm\\.googleapis\\.com|[a-z0-9.-]+\\.push\\.apple\\.com|[a-z0-9.-]+\\.mozilla\\.com|[a-z0-9.-]+\\.notify\\.windows\\.com)\\//)"
          },
          "keys": {
            "p256dh": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "auth": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "prefs": {
          "streak": {
            ".validate": "newData.isBoolean()"
          },
          "daily": {
            ".validate": "newData.isBoolean()"
          },
          "away": {
            ".validate": "newData.isBoolean()"
          },
          "hour": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 23"
          },
          "$other": {
            ".validate": false
          }
        },
        "sent": {
          "$kind": {
            ".validate": "newData.isNumber() || newData.isString()"
          }
        },
        "lang": {
          ".validate": "newData.isString() && newData.val().length <= 5"
        },
        "app": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "language": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "hello": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "tz": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "streak": {
          ".validate": "newData.isNumber()"
        },
        "lastDay": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "seen": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "school": {
      "n": {
        ".read": true,
        "$pub": {
          ".write": "newData.child('gone').isString() && newData.child('gone').val().matches(/^[A-Za-z0-9]{32}$/) && root.child('school/s/' + newData.child('gone').val() + '/info/pub').val() === $pub && !newData.parent().parent().child('s').child(newData.child('gone').val()).exists()"
        }
      },
      "a": {
        "$code": {
          ".read": "$code.matches(/^[0-9]{15}$/)",
          ".write": "!newData.exists() && $code.matches(/^[0-9]{15}$/)"
        }
      },
      "s": {
        "$key": {
          ".read": "$key.matches(/^[A-Za-z0-9]{32}$/) && data.child('info').exists()",
          "teachers": {
            ".write": "root.child('school/s/' + $key + '/info').exists()"
          },
          "classes": {
            ".write": "root.child('school/s/' + $key + '/info').exists()"
          },
          "students": {
            ".write": "root.child('school/s/' + $key + '/info').exists()"
          },
          "homework": {
            ".write": "root.child('school/s/' + $key + '/info').exists()"
          },
          "saves": {
            ".write": "root.child('school/s/' + $key + '/info').exists()"
          },
          "compliance": {
            ".write": "root.child('school/s/' + $key + '/info').exists()"
          },
          "settings": {
            ".write": "root.child('school/s/' + $key + '/info').exists()"
          },
          ".write": "!newData.exists() && $key.matches(/^[A-Za-z0-9]{32}$/) && data.child('info').exists()"
        }
      },
      "l": {
        "$u": {
          "$h": {
            ".read": "$h.matches(/^[0-9a-f]{64}$/)",
            ".write": "$u.matches(/^[a-z0-9]{3,40}$/) && $h.matches(/^[0-9a-f]{64}$/)",
            ".validate": "newData.child('role').isString() && newData.child('key').isString() && newData.child('key').val().length === 32"
          }
        }
      },
      "q": {
        "$t": {
          ".read": "$t.matches(/^[A-Za-z0-9]{32}$/)",
          ".write": "$t.matches(/^[A-Za-z0-9]{32}$/)",
          ".validate": "newData.child('role').val() === 'student' && newData.child('key').isString()"
        }
      },
      "p": {
        "$k": {
          ".read": "$k.matches(/^[A-Za-z0-9]{32}$/)",
          ".write": "$k.matches(/^[A-Za-z0-9]{32}$/)"
        }
      },
      "u": {
        "$u": {
          ".read": true,
          ".write": "(!data.exists() && $u.matches(/^[a-z0-9]{3,40}$/)) || (!newData.exists() && !newData.parent().parent().child('l').child($u).exists())",
          ".validate": "newData.val() === true"
        }
      }
    },
    "status": {
      ".read": true
    }
  }
}
